# Ambiente: development | test | production
APP_ENV=development
LOG_LEVEL=WARNING

PORTAL_GD_URL=https://gdneoenergiapernambuco.neoenergia.com/
PLANILHA_PATH=
CLIENTES_ROOT=Z:\Clientes

DOWNLOADS_DIR=data/downloads
LOGS_DIR=data/logs
AUTH_STATE_PATH=data/auth/storage_state.json
BROWSER_PROFILE_DIR=data/browser_profile_edge
BROWSER_CHANNEL=msedge
HEADLESS=false
USE_PERSISTENT_CONTEXT=false

# Segurança: CDP deve permanecer local por padrão.
CDP_MODE=true
CDP_ENDPOINT=http://127.0.0.1:9222
ALLOW_REMOTE_CDP=false

# Comece sempre em simulação.
DRY_RUN=true
BACKUP_EXCEL=true
APPLY_EXCEL=true
APPLY_ARCHIVE=true

CREATE_YEAR_SHEET_IF_MISSING=true
EXCEL_DEFAULT_TEMPLATE_SHEET=2025
MOVE_WRONG_YEAR_ROWS=true
WORKBOOK_REPAIR_MODE=visual_only
STRICT_WORKBOOK_VALIDATION=false

ARCHIVE_FALLBACK_MODE=pending
ARCHIVE_ENTRY_FOLDER_WHEN_MULTIPLE=latest
ARCHIVE_ALLOW_EXISTING_LEGACY_GD=false

RESUME_PIPELINE=true
SKIP_ALREADY_COMPLETED=true
RESET_PIPELINE_STATE=false
FORCE_REPROCESS_PROTOCOLS=

MAX_COMPLETED_TO_PROCESS=1
ENABLE_PORTAL_PAGINATION=false
MAX_PORTAL_PAGES=1
MAX_PROTOCOL_NOT_FOUND_ERRORS=3
REPROCESS_EXISTING_PDFS=false
PROCESS_EXISTING_AFTER_SKIP=true

CACHE_CLIENT_FOLDER_LOOKUP=true
CLIENT_FOLDER_CACHE_TTL_DAYS=30
CLIENT_FOLDER_CACHE_MAX_ENTRIES=5000
FUZZY_AUTO_MATCH_SCORE=90
FUZZY_REVIEW_MATCH_SCORE=75

MAX_PDF_SIZE_MB=25
